# Overview, lower down: dev error against one cost per chart, each chart's Pareto front as the line. Admissible
# iterations only (WHY: a solution that fails a gate is no trade-off anyone can take; the page says how many are left out).
# Costs: scorecard.json diagnostics (energy_j, host_compute_ms_p95) and the repo's ablations/costs.py code_lines.
# Ablation runs are study variants, not search steps: not plotted. Data: fold.py @ 9ead945.
data: frontier.json
open: { mode: side, splitAt: 760 }
properties:
  solution: { displayName: "Solution" }
  n: { displayName: "#", type: number, decimals: 0 }
  objective: { displayName: "Dev error", type: number, decimals: 3 }
  admissible: { displayName: "Admissible" }
  verdict: { displayName: "Verdict" }
  change: { displayName: "The one change" }
  energy_j: { displayName: "Motor energy", type: number, decimals: 0 }
  host_compute_ms_p95: { displayName: "Host compute p95", type: number, decimals: 3 }
  code_lines: { displayName: "Code size", type: number, decimals: 0 }
views:
  - type: chart
    name: Motor energy
    filters: 'admissible == true'
    order: [id, objective, energy_j, change]
    chart:
      layer:
        # WHY one line per tier with only the front's drawn: data-ui hands every layer the same rows (a layer's own
        # filter is not applied), so the front is its own series and the other tiers' lines get a transparent stroke
        - mark: { type: line, interpolate: step-after, color: "#e8741c", strokeWidth: 2 }
          encoding:
            x: { field: energy_j, type: quantitative, title: "motor energy (J)" }
            y: { field: objective, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
            detail: { field: tier_energy_j, type: nominal }
            stroke: { field: tier_energy_j, type: nominal, scale: { domain: [on the front, admissible, not admissible], range: ["#e8741c", "rgba(0,0,0,0)", "rgba(0,0,0,0)"] }, legend: null }
        - mark: { type: point, filled: true, size: 55 }
          encoding:
            x: { field: energy_j, type: quantitative, title: "motor energy (J)", scale: { zero: false } }
            y: { field: objective, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
            color:
              field: tier_energy_j
              type: nominal
              title: null
              scale: { domain: [on the front, admissible, not admissible], range: ["#e8741c", "#9aa1aa", "#d62728"] }
              legend: { orient: top }
            tooltip: [{ field: id, title: solution }, { field: objective, format: ".4f", title: dev error (mm) }, { field: energy_j, title: "motor energy (J)" }, { field: tier_energy_j, title: where }]
  - type: chart
    name: Host compute p95
    filters: 'admissible == true'
    order: [id, objective, host_compute_ms_p95, change]
    chart:
      layer:
        # WHY one line per tier with only the front's drawn: data-ui hands every layer the same rows (a layer's own
        # filter is not applied), so the front is its own series and the other tiers' lines get a transparent stroke
        - mark: { type: line, interpolate: step-after, color: "#e8741c", strokeWidth: 2 }
          encoding:
            x: { field: host_compute_ms_p95, type: quantitative, title: "host compute p95 (ms)" }
            y: { field: objective, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
            detail: { field: tier_host_compute_ms_p95, type: nominal }
            stroke: { field: tier_host_compute_ms_p95, type: nominal, scale: { domain: [on the front, admissible, not admissible], range: ["#e8741c", "rgba(0,0,0,0)", "rgba(0,0,0,0)"] }, legend: null }
        - mark: { type: point, filled: true, size: 55 }
          encoding:
            x: { field: host_compute_ms_p95, type: quantitative, title: "host compute p95 (ms)", scale: { zero: false } }
            y: { field: objective, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
            color:
              field: tier_host_compute_ms_p95
              type: nominal
              title: null
              scale: { domain: [on the front, admissible, not admissible], range: ["#e8741c", "#9aa1aa", "#d62728"] }
              legend: { orient: top }
            tooltip: [{ field: id, title: solution }, { field: objective, format: ".4f", title: dev error (mm) }, { field: host_compute_ms_p95, title: "host compute p95 (ms)" }, { field: tier_host_compute_ms_p95, title: where }]
  - type: chart
    name: Code size
    filters: 'admissible == true'
    order: [id, objective, code_lines, change]
    chart:
      layer:
        # WHY one line per tier with only the front's drawn: data-ui hands every layer the same rows (a layer's own
        # filter is not applied), so the front is its own series and the other tiers' lines get a transparent stroke
        - mark: { type: line, interpolate: step-after, color: "#e8741c", strokeWidth: 2 }
          encoding:
            x: { field: code_lines, type: quantitative, title: "code size (lines)" }
            y: { field: objective, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
            detail: { field: tier_code_lines, type: nominal }
            stroke: { field: tier_code_lines, type: nominal, scale: { domain: [on the front, admissible, not admissible], range: ["#e8741c", "rgba(0,0,0,0)", "rgba(0,0,0,0)"] }, legend: null }
        - mark: { type: point, filled: true, size: 55 }
          encoding:
            x: { field: code_lines, type: quantitative, title: "code size (lines)", scale: { zero: false } }
            y: { field: objective, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
            color:
              field: tier_code_lines
              type: nominal
              title: null
              scale: { domain: [on the front, admissible, not admissible], range: ["#e8741c", "#9aa1aa", "#d62728"] }
              legend: { orient: top }
            tooltip: [{ field: id, title: solution }, { field: objective, format: ".4f", title: dev error (mm) }, { field: code_lines, title: "code size (lines)" }, { field: tier_code_lines, title: where }]
