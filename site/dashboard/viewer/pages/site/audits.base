# Audits: one row per audit round (audits/<date>-r<n>.md); none exists yet
# Stock: every black-box agent ships this file and swaps the data file. Grammar: Obsidian Bases + data-ui keys
# (data-ui docs/CONTRACT.md §5). Data: proposals-pages/_build/fold.py from trajectory_tracking_agent @ 9ead945.
data: audits.json
facets:
  - verdict
  - auditor
  - scope
open: { mode: side, splitAt: 980 }
properties:
  round: { displayName: "Round" }
  date: { displayName: "Ran at" }
  auditor: { displayName: "Auditor" }
  model: { displayName: "Model" }
  effort: { displayName: "Effort" }
  scope: { displayName: "Scope" }
  verdict: { displayName: "Verdict" }
  commit: { displayName: "Commit" }
  findings: { displayName: "Findings", type: number, decimals: 0 }
  feedback: { displayName: "Feedback it filed" }
  path: { displayName: "File" }
views:
  - type: table
    name: Rounds
    order: [round, date, auditor, model, effort, scope, verdict, findings, commit]
    sort:
      - { property: date, direction: DESC }
    display: { verdict: status }
  - type: timeline
    name: Rounds timeline
    start: date
    title: round
    color: verdict
    groupBy: { property: auditor, direction: ASC }
  - type: tracker
    name: Verdict matrix
    groupBy: { property: scope }
    sort:
      - { property: date, direction: ASC }
    tracker:
      state: verdict
      column: round
      label: auditor
