# Overview · KPIs: one row per top-level KPI (the viewer's kpis slice)
# Stock: every black-box agent ships this file and swaps the data file. Grammar: Obsidian Bases + data-ui keys
# (data-ui docs/CONTRACT.md §5). Data: proposals-pages/_build/fold.py from trajectory_tracking_agent @ 9ead945.
data: kpis.json
open: { mode: side, splitAt: 760 }
properties:
  label: { displayName: KPI }
  value: { displayName: Now, digits: 3 }
views:
  - type: table
    name: KPIs
    order: [label, value, unit, delta, from]
    display: { value: sparkline }
    columnSize: { label: 150, value: 230, unit: 60, delta: 130 }
