# References: one row per thing the box builds on (CONTRACT §17): references/*.md (one note each) or REFERENCES.md's
# list items, the ## heading above an item its section. A row from a note opens as the note (Obsidian's look).
facets:
  - section
  - host
  - kind
open: { mode: side, splitAt: 980 }
properties:
  title: { displayName: "Reference" }
  why: { displayName: "What we take from it" }
  section: { displayName: "Section" }
  url: { displayName: "Link" }
  host: { displayName: "Site" }
  kind: { displayName: "Kind" }
  where: { displayName: "Where" }
  source: { displayName: "Listed in" }
  line: { displayName: "Line" }
  n: { displayName: "#" }
views:
  - type: table
    name: References
    order: [title, why, url]
    groupBy: { property: section }
    sort:
      - { property: n, direction: ASC }
    display: { url: link }
  - type: list
    name: List
    order: [title, why, url]
    groupBy: { property: section }
    sort:
      - { property: n, direction: ASC }
  - type: cards
    name: Cards
    order: [title, why, host, section]
    cardSize: 300
    sort:
      - { property: n, direction: ASC }
